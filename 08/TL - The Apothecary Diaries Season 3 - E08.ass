Dialogue: 0,0:00:00.00,0:00:10.00,ssrly,,0,0,0,,{\an7\fnSweetest Cat Ever\fs50\b0\fad(400,400)\bord2\blur5\shad0\4c&H000000&\4a&HFF&\pos(20,-2)}{\c&HFFFF00&}{\4c&H8485E4&}SomeSub ekip arkadaşı arıyor!\N{\c&HFFFFFF&}Çevirmen:{\c&HFFFF00&} Riley\N{\c&HFFFFFF&}Encode:{\c&HFFFF00&} Velnoxy\N{\c&HFFFFFF&}Redaktör:{\c&HFFFF00&} shi\N{\c&HFFFFFF&}Discord:{\c&HFFFF00&} discord.gg/somesub
Dialogue: 0,0:01:32.80,0:01:36.08,ssrly,,0,0,0,,Sence Yue'nin batıya yaptığı yolculuk iyi gidiyor mu?
Dialogue: 0,0:01:36.08,0:01:41.52,ssrly,,0,0,0,,Öncelikle kağıt zanaatkarlarının köyünü denetleyecek, yani bence henüz yolun yarısında.
Dialogue: 0,0:01:41.52,0:01:44.08,ssrly,,0,0,0,,Anlıyorum, henüz yolun yarısında.
Dialogue: 0,0:01:48.09,0:01:50.90,ssrly,,0,0,0,,Jinshi diye bilinen bir hadımın kaybolmasıyla,
Dialogue: 0,0:01:50.90,0:01:53.68,ssrly,,0,0,0,,İmparatora doğrudan hizmet etme görevine geri döndüm.
Dialogue: 0,0:01:55.68,0:02:00.44,ssrly,,0,0,0,,Ma klanı, ulusun çiçeğini korumakla görevlidir.
Dialogue: 0,0:02:01.00,0:02:04.64,ssrly,,0,0,0,,Bu yüzden, çok küçük yaşlarından beri imparatorun yanında bulunmuşumdur.
Dialogue: 0,0:02:07.42,0:02:10.98,ssrly,,0,0,0,,İmparator ve çocukluk arkadaşı Ah-Duo...
Dialogue: 0,0:02:10.98,0:02:12.11,ssrly,,0,0,0,,Ve..
Dialogue: 0,0:02:12.80,0:02:14.38,ssrly,,0,0,0,,Biri daha.
Dialogue: 0,0:02:35.54,0:02:40.14,ssrly,,0,0,0,,Basen, adını aydan alan çiçeği batıya olan yolculuğu sırasında koruyor.
Dialogue: 0,0:02:40.94,0:02:46.94,ssrly,,0,0,0,,Ama Basen, Shi klanı ile olan savaşta Ay'ı  koruyamadı.
Dialogue: 0,0:02:48.15,0:02:50.28,ssrly,,0,0,0,,Endişelenmediğimi söylemek  bir yalan olurdu.
Dialogue: 0,0:02:50.28,0:02:53.34,ssrly,,0,0,0,,Ama yanlarında eczacı kız \Nolduğundan, her şey yolunda gitmeli.
Dialogue: 0,0:02:53.34,0:02:56.46,ssrly,,0,0,0,,O kız dayanıklılığını defalarca kez kanıtladı.
Dialogue: 0,0:02:57.06,0:02:58.34,ssrly,,0,0,0,,Sorun şu ki...
Dialogue: 0,0:02:58.64,0:03:03.00,ssrly,,0,0,0,,O köyden ayrıldıktan ve Batı Başkenti'ne ulaştıklarında ne yapacakları...
Dialogue: 0,0:03:03.68,0:03:09.00,ssrly,,0,0,0,,Oğlumu kızın zehir tadımı yapmak için onlarla gitmesi gerektiğine ikna ettim.
Dialogue: 0,0:03:09.00,0:03:11.82,ssrly,,0,0,0,,Ay Prens'in ise ikna edilmesi gerekmedi.
Dialogue: 0,0:03:12.36,0:03:14.24,ssrly,,0,0,0,,Zor günler geçirecek.
Dialogue: 0,0:03:14.50,0:03:17.12,ssrly,,0,0,0,,Hangi çiçekler ona akın edecek?
Dialogue: 0,0:03:17.12,0:03:20.24,ssrly,,0,0,0,,Çiçeklerin akın etmesi mi? \NBu çok orijinal bir ifade.
Dialogue: 0,0:03:20.24,0:03:22.90,ssrly,,0,0,0,,Onları böceklere benzetmemden hoşlanmazdı.
Dialogue: 0,0:03:23.36,0:03:25.70,ssrly,,0,0,0,,Bahçemin durumuna bakarak bunu anlayabiliyorum.
Dialogue: 0,0:03:26.00,0:03:28.98,ssrly,,0,0,0,,Belki de imparatorun biraz üzgün gözükmesinin sebebi,
Dialogue: 0,0:03:28.98,0:03:33.02,ssrly,,0,0,0,,bu köşkün sahibi, Ah-Duo'nun yokluğudur.
Dialogue: 0,0:03:33.58,0:03:36.20,ssrly,,0,0,0,,O da Batı Başkenti'ne doğru yola koyuldu.
Dialogue: 0,0:03:36.64,0:03:38.76,ssrly,,0,0,0,,Yanında birini de götürerek.
Dialogue: 0,0:03:40.90,0:03:42.52,ssrly,,0,0,0,,Çekirge istilası...
Dialogue: 0,0:03:42.90,0:03:47.04,ssrly,,0,0,0,,Batı bölgesinin etkilenme ihtimali yüksek.
Dialogue: 0,0:03:47.84,0:03:51.38,ssrly,,0,0,0,,Ay Prens bununla başa çıkmakla görevlendirilmişti.a
Dialogue: 0,0:03:52.04,0:03:54.04,ssrly,,0,0,0,,Eğer çekirgeler batıdan geliyorsa,
Dialogue: 0,0:03:54.04,0:03:57.04,ssrly,,0,0,0,,batı bölgesinin etkilelenme ihtimali yüksek.
Dialogue: 0,0:03:57.38,0:03:59.40,ssrly,,0,0,0,,Aç insanlar vahşileşir,
Dialogue: 0,0:03:59.40,0:04:03.28,ssrly,,0,0,0,,Geçmişte bu tür olaylar pek çok savaşın çıkmasına neden olmuştur.
Dialogue: 0,0:04:04.22,0:04:06.56,ssrly,,0,0,0,,Umarım sadece aşırı\N temkinli oluyorumdur ama...
Dialogue: 0,0:04:06.86,0:04:07.44,ssrly,,0,0,0,,Evet.
Dialogue: 0,0:04:07.74,0:04:11.64,ssrly,,0,0,0,,Bir zamanlar Sei-shu eyaletinin batı kesimini yöneten Yi klanı.
Dialogue: 0,0:04:11.88,0:04:14.40,ssrly,,0,0,0,,On yıldan fazla bir süre önce ortadan kaldırılmıştı.
Dialogue: 0,0:04:15.04,0:04:18.56,ssrly,,0,0,0,,İmparatoriçe döneminde {\i1}komplo{\i0} kurdukları gerekçesiyle yok edildiler.
Dialogue: 0,0:04:19.32,0:04:24.24,ssrly,,0,0,0,,Şimdi o bölge, İmparatoriçe Gyokuyou'nun \Nbabası Gyokuen tarafından yönetiliyor.
Dialogue: 0,0:04:24.98,0:04:29.44,ssrly,,0,0,0,,Şu an için isimsiz ama imparator\N yakın zamanda ona bir harf verecek.
Dialogue: 0,0:04:30.16,0:04:33.98,ssrly,,0,0,0,,Eğer savaş çıksaydı, Batı bir temel nokta olacaktı.
Dialogue: 0,0:04:34.44,0:04:37.46,ssrly,,0,0,0,,Bu yüzden Leydi Gyokuyo'yu eşi yaptı.
Dialogue: 0,0:04:37.90,0:04:40.84,ssrly,,0,0,0,,Sonuçta evlilik de bir siyasi araçtır.
Dialogue: 0,0:04:41.16,0:04:45.98,ssrly,,0,0,0,,Ülkenin en tepesinde bile olsam, ara sıra kayınpederimi \Nmemnun etmek için çabalamam gerekiyor.
Dialogue: 0,0:04:46.88,0:04:50.86,ssrly,,0,0,0,,Zaman zaman benim yerimde olmanın ne kadar zor olduğunu anlamalı.
Dialogue: 0,0:05:04.28,0:05:07.84,ssrly,,0,0,0,,Kuzeybatımızda Hokuaren adında bir federasyon devleti bulunmakta.
Dialogue: 0,0:05:08.98,0:05:12.10,ssrly,,0,0,0,,Geniş bir tahıl üretim bölgesi ve bol orman kaynaklarına sahipler.
Dialogue: 0,0:05:12.10,0:05:15.19,ssrly,,0,0,0,,Ve tarih boyunca Li ulusuyla -bizimle- defalarca kez çatışmışlardır.
Dialogue: 0,0:05:15.98,0:05:22.28,ssrly,,0,0,0,,Hokuaren yabancıların bize sataşmasının başlıca nedenidir.
Dialogue: 0,0:05:23.08,0:05:26.72,ssrly,,0,0,0,,Resmi diplomatik ilişkiler bulunmamaktadır, doğrudan bir iletişim de yoktur.
Dialogue: 0,0:05:26.72,0:05:28.92,ssrly,,0,0,0,,Başka ulusların aramıza girmesiyle-
Dialogue: 0,0:05:29.74,0:05:31.06,ssrly,,0,0,0,,Dinliyor musun?!
Dialogue: 0,0:05:31.52,0:05:32.60,ssrly,,0,0,0,,Dinliyorum!
Dialogue: 0,0:05:32.84,0:05:36.90,ssrly,,0,0,0,,Batı Başkenti'nde, diğer ülkelerden gelen birkaç üst süzey yetkiliyle buluşacağız.
Dialogue: 0,0:05:36.90,0:05:40.32,ssrly,,0,0,0,,Hokuaren'e bağlı olanlar da orada olacak.
Dialogue: 0,0:05:40.90,0:05:43.08,ssrly,,0,0,0,,Batı Başkent demek...
Dialogue: 0,0:05:43.08,0:05:46.66,ssrly,,0,0,0,,Yolculuk araç ve tekneyle bile iki haftadan çok sürer.
Dialogue: 0,0:05:47.18,0:05:50.18,ssrly,,0,0,0,,Geride bıraktığım Chou-u ve Sazen iyi durumda mı acaba?
Dialogue: 0,0:05:50.78,0:05:52.54,ssrly,,0,0,0,,Eh, onlar bir şekilde idare eder.
Dialogue: 0,0:05:53.74,0:05:59.90,ssrly,,0,0,0,,Bu yüzden Basen bana sıkıcı dışişleri konularını \Nöğretmek için bu kadar uğraşıyor.
Dialogue: 0,0:06:02.80,0:06:03.80,ssrly,,0,0,0,,Varmak üzereyiz.
Dialogue: 0,0:06:07.98,0:06:09.66,ssrly,,0,0,0,,Geceyi bu köyde geçireceğiz.
Dialogue: 0,0:06:10.18,0:06:11.58,ssrly,,0,0,0,,Ortalıkta dolaşma, tamam mı?
Dialogue: 0,0:06:13.98,0:06:15.40,ssrly,,0,0,0,,Yemek alacağım.
Dialogue: 0,0:06:15.40,0:06:17.44,ssrly,,0,0,0,,Dinliyor muydun ki?
Dialogue: 0,0:06:19.32,0:06:19.94,ssrly,,0,0,0,,Jin-
Dialogue: 0,0:06:20.36,0:06:21.52,ssrly,,0,0,0,,Ben ona eşlik ederim.
Dialogue: 0,0:06:22.30,0:06:23.32,ssrly,,0,0,0,,Bu herif...
Dialogue: 0,0:06:28.12,0:06:30.04,ssrly,,0,0,0,,Satışta ilginç bir şey var mı?
Dialogue: 0,0:06:30.04,0:06:31.84,ssrly,,0,0,0,,İlginç bir şey?
Dialogue: 0,0:06:32.37,0:06:35.10,ssrly,,0,0,0,,Anlaşılan bu bölge bolca kenevir yetiştiriyor.
Dialogue: 0,0:06:35.10,0:06:37.40,ssrly,,0,0,0,,Çoğu giysi ondan yapılmaya benziyor.
Dialogue: 0,0:06:37.40,0:06:41.22,ssrly,,0,0,0,,Sadece onunla üşüyor olsalar \Ngerek ki onu kürkle birleştiriyorlar.
Dialogue: 0,0:06:42.72,0:06:46.12,ssrly,,0,0,0,,Ayrıca, ekmeğe kenevir tohumu koyuyorlar.
Dialogue: 0,0:06:46.12,0:06:48.39,ssrly,,0,0,0,,Ve yağda da onu kullanıyorlar.
Dialogue: 0,0:06:48.39,0:06:49.98,ssrly,,0,0,0,,Kızartıyorlar.
Dialogue: 0,0:06:49.98,0:06:51.38,ssrly,,0,0,0,,Ayrıca...
Dialogue: 0,0:06:51.64,0:06:52.62,ssrly,,0,0,0,,Ne oldu?
Dialogue: 0,0:06:53.22,0:06:57.40,ssrly,,0,0,0,,Hiçbir şey sadece çok içiyorlar diye düşündüm.
Dialogue: 0,0:06:57.82,0:06:58.66,ssrly,,0,0,0,,Çok mu içiyorlar?
Dialogue: 0,0:06:58.96,0:07:02.34,ssrly,,0,0,0,,Kenevir az miktarda kullanılırsa bir ilaçtır.
Dialogue: 0,0:07:02.34,0:07:05.32,ssrly,,0,0,0,,Ama sürekli kullanılırsa bağımlılık yapar.
Dialogue: 0,0:07:05.32,0:07:08.41,ssrly,,0,0,0,,Ve aşırı dozda bir zehirdir.
Dialogue: 0,0:07:08.41,0:07:11.41,ssrly,,0,0,0,,Yani her zehire hemen atlamıyorsun, değil mi?
Dialogue: 0,0:07:11.74,0:07:14.38,ssrly,,0,0,0,,Bağımlılık yapanları korkunç.
Dialogue: 0,0:07:14.38,0:07:17.22,ssrly,,0,0,0,,Onlardan sadece karar vermekle kurtulamazsın.
Dialogue: 0,0:07:17.22,0:07:22.56,ssrly,,0,0,0,,Bırakmaya karar versen bile, soğuk bir sabahta yatağından bile daha caziptir.
Dialogue: 0,0:07:23.40,0:07:26.98,ssrly,,0,0,0,,Bu o kadar da kötü mü? Oda sıcak olduğu sürece sorun olmaz.
Dialogue: 0,0:07:27.38,0:07:31.14,ssrly,,0,0,0,,Ah doğru ya, bu adam sıradan insanların\N benzetmelerini anlayamaz.
Dialogue: 0,0:07:32.00,0:07:37.44,ssrly,,0,0,0,,Eminim ki dadı o uyanmadan önce bir\N kömür ocağıyla odayı ısıtıyordur.
Dialogue: 0,0:07:38.04,0:07:41.78,ssrly,,0,0,0,,Yaşlı Leydi Suiren'i  bu kadar çok \Nçalıştırması ne kadar da berbat.
Dialogue: 0,0:07:42.48,0:07:45.66,ssrly,,0,0,0,,Ve bunu yaptığının farkında bile değil.
Dialogue: 0,0:07:46.60,0:07:49.20,ssrly,,0,0,0,,Sen bana en son böyle bakalı uzun zaman oldu.
Dialogue: 0,0:07:49.20,0:07:51.14,ssrly,,0,0,0,,Bu adam gerçekten iyi mi?
Dialogue: 0,0:07:52.24,0:07:54.32,ssrly,,0,0,0,,Her neyse, hadi yiyecek alalım.
Dialogue: 0,0:07:55.26,0:07:56.04,ssrly,,0,0,0,,Bu nedir?
Dialogue: 0,0:07:56.46,0:07:57.80,ssrly,,0,0,0,,Ona Mahua deniyor.
Dialogue: 0,0:07:58.04,0:08:00.46,ssrly,,0,0,0,,Kızartılmış hamurdan yapılma bir atıştırmalık.
Dialogue: 0,0:08:01.56,0:08:03.90,ssrly,,0,0,0,,Böylesine bir asilin ağız tadına yakışır mı acaba?
Dialogue: 0,0:08:04.14,0:08:05.10,ssrly,,0,0,0,,Bir tane lütfen.
Dialogue: 0,0:08:05.84,0:08:06.56,ssrly,,0,0,0,,Buyrun.
Dialogue: 0,0:08:07.52,0:08:10.02,ssrly,,0,0,0,,Neden sadece bir tane? Bir tane daha istemez misin?
Dialogue: 0,0:08:10.02,0:08:11.38,ssrly,,0,0,0,,Tadı güzelse olur.
Dialogue: 0,0:08:13.64,0:08:15.28,ssrly,,0,0,0,,Hey, sadece sen mi yiyeceksin?
Dialogue: 0,0:08:16.28,0:08:17.42,ssrly,,0,0,0,,Zehir tadımı yapıyorum.
Dialogue: 0,0:08:19.22,0:08:21.20,ssrly,,0,0,0,,Taze kızartılmış olmasının da etkisi var.
Dialogue: 0,0:08:21.20,0:08:23.14,ssrly,,0,0,0,,Ama diğerleri için yeterli olmalı.
Dialogue: 0,0:08:23.82,0:08:25.22,ssrly,,0,0,0,,Bir torba alayım lütfen.
Dialogue: 0,0:08:25.22,0:08:25.98,ssrly,,0,0,0,,Teşekkürler.
Dialogue: 0,0:08:30.46,0:08:31.78,ssrly,,0,0,0,,Fena değil.
Dialogue: 0,0:08:31.78,0:08:37.04,ssrly,,0,0,0,,Normalde yediğinden daha iyi olsaydı saray aşçıları işsiz kalırdı.
Dialogue: 0,0:08:37.46,0:08:40.02,ssrly,,0,0,0,,Etrafta dolaşmanız uygun mu, Jinshi-sama?
Dialogue: 0,0:08:40.50,0:08:43.60,ssrly,,0,0,0,,Sanırım kağıt zanaatkarlarının köyünde Basen'i yordum.
Dialogue: 0,0:08:44.10,0:08:47.42,ssrly,,0,0,0,,Bir süre tembellik etmemin ona da iyi geleceğini düşünüyorum.
Dialogue: 0,0:08:47.92,0:08:49.10,ssrly,,0,0,0,,Anlıyorum.
Dialogue: 0,0:08:49.10,0:08:52.51,ssrly,,0,0,0,,Basen iyi bir yalancı değil.
Dialogue: 0,0:08:52.51,0:08:56.34,ssrly,,0,0,0,,Jinshi-sama'nın patronunu oynamak onun için acı verici olmalı.
Dialogue: 0,0:08:56.34,0:08:59.72,ssrly,,0,0,0,,Bu tür şeylerin onu bu kadar strese sokma şekli bana Goushun'u hatırlatıyor.
Dialogue: 0,0:09:00.74,0:09:03.84,ssrly,,0,0,0,,O halde yemek stoğumuzu yenilemeye devam edelim.
Dialogue: 0,0:09:03.84,0:09:05.16,ssrly,,0,0,0,,Evet.
Dialogue: 0,0:09:09.55,0:09:10.12,ssrly,,0,0,0,,Bu..
Dialogue: 0,0:09:11.70,0:09:12.53,ssrly,,0,0,0,,Afedersiniz.
Dialogue: 0,0:09:13.26,0:09:14.00,ssrly,,0,0,0,,Ne oldu?
Dialogue: 0,0:09:14.42,0:09:17.92,ssrly,,0,0,0,,Bunlardan birkaç tanesini alabilir miyiz? Parasını ödeyeceğiz.
Dialogue: 0,0:09:22.32,0:09:23.72,ssrly,,0,0,0,,Hangilerini istiyorsun?
Dialogue: 0,0:09:24.32,0:09:25.44,ssrly,,0,0,0,,Bu ve şu.
Dialogue: 0,0:09:25.44,0:09:27.04,ssrly,,0,0,0,,Ve ondan on kişilik.
Dialogue: 0,0:09:27.32,0:09:29.12,ssrly,,0,0,0,,Ve eğer ilginç bir şey varsa...
Dialogue: 0,0:09:29.60,0:09:30.72,ssrly,,0,0,0,,Bir saniye lütfen.
Dialogue: 0,0:09:32.55,0:09:35.98,ssrly,,0,0,0,, Hah? Gerçekten iyi malları seçiyor.
Dialogue: 0,0:09:35.98,0:09:40.02,ssrly,,0,0,0,,Bunlara... Bu fiyata ne dersin?
Dialogue: 0,0:09:40.02,0:09:41.80,ssrly,,0,0,0,,Beklediğimden daha ucuz.
Dialogue: 0,0:09:42.52,0:09:45.02,ssrly,,0,0,0,,Teşekkürler, ani bir istek \Niçin bu harika bir fiyat.
Dialogue: 0,0:09:47.08,0:09:50.30,ssrly,,0,0,0,,Tanrı ne zaman izliyor bilemezsin, değil mi?
Dialogue: 0,0:09:50.62,0:09:52.90,ssrly,,0,0,0,,Bak, bir tanesi hemen şurada.
Dialogue: 0,0:09:56.14,0:09:58.52,ssrly,,0,0,0,,Yani bu bölgede yılanlara mı tapılıyor?
Dialogue: 0,0:09:58.94,0:09:59.84,ssrly,,0,0,0,,Evet öyle.
Dialogue: 0,0:10:00.28,0:10:03.00,ssrly,,0,0,0,,Beyaz bir yılan görünce iyi bir hasat olacağını anlarız.
Dialogue: 0,0:10:05.36,0:10:09.78,ssrly,,0,0,0,,Jinshi-sama da Beyaz Leydi hakkında duymuş olmalı.
Dialogue: 0,0:10:09.78,0:10:13.48,ssrly,,0,0,0,,Belki onunla başa çıkmak görevlerinden biridir.
Dialogue: 0,0:10:14.26,0:10:18.02,ssrly,,0,0,0,,Acaba o şüpheli büyücü nereye gitti?
Dialogue: 0,0:10:18.68,0:10:22.38,ssrly,,0,0,0,,Eğer batıya doğru gidiyorsanız dikkatli olun.
Dialogue: 0,0:10:22.38,0:10:23.52,ssrly,,0,0,0,,Neden?
Dialogue: 0,0:10:24.18,0:10:28.06,ssrly,,0,0,0,,Son zamanlarda batı otoyolunda çok sayıda haydut dolaşıyor.
Dialogue: 0,0:10:28.06,0:10:30.40,ssrly,,0,0,0,,Tüccarlar bile oradan kaçınıyor.
Dialogue: 0,0:10:30.40,0:10:31.78,ssrly,,0,0,0,,Anlıyorum.
Dialogue: 0,0:10:31.78,0:10:35.44,ssrly,,0,0,0,,Belki de raflarda duran yiyecekleri genellikle tüccarlara satıyordur.
Dialogue: 0,0:10:35.44,0:10:37.32,ssrly,,0,0,0,,Hizmetinin iyi olmasına şaşmamalı.
Dialogue: 0,0:10:37.76,0:10:39.94,ssrly,,0,0,0,,Teşekkürler, dikkatli olacağız.
Dialogue: 0,0:10:40.14,0:10:41.98,ssrly,,0,0,0,,Evet, dikkatli olun.
Dialogue: 0,0:10:48.24,0:10:50.44,ssrly,,0,0,0,,Artık dönelim.
Dialogue: 0,0:10:50.44,0:10:52.63,ssrly,,0,0,0,,Evet, öyle yapalım.
Dialogue: 0,0:11:01.28,0:11:03.68,ssrly,,0,0,0,,Müsadenizle, biz döndük.
Dialogue: 0,0:11:05.34,0:11:06.54,ssrly,,0,0,0,,Atların durumu nasıl?
Dialogue: 0,0:11:06.84,0:11:09.22,ssrly,,0,0,0,,Evet, sabaha hazır olmalılar.
Dialogue: 0,0:11:09.92,0:11:12.32,ssrly,,0,0,0,,Fakat bir yerel rehber kiralamamız gerekecek.
Dialogue: 0,0:11:12.65,0:11:15.32,ssrly,,0,0,0,,Yerel bir rehber... Yani atla yük taşıyan kişi.
Dialogue: 0,0:11:16.38,0:11:16.66,ssrly,,0,0,0,,Hmm?
Dialogue: 0,0:11:17.90,0:11:19.18,ssrly,,0,0,0,,Hemen ona çay servis et!
Dialogue: 0,0:11:21.22,0:11:22.50,ssrly,,0,0,0,,Sıcak su getireyim.
Dialogue: 0,0:11:23.04,0:11:25.48,ssrly,,0,0,0,,Hayır, böylesi iyi. Çayı ılık severim.
Dialogue: 0,0:11:29.86,0:11:31.32,ssrly,,0,0,0,,Haydutlar hakkında duydum.
Dialogue: 0,0:11:31.72,0:11:33.52,ssrly,,0,0,0,,Evet, biz de haberdarız.
Dialogue: 0,0:11:34.08,0:11:36.68,ssrly,,0,0,0,,Dediklerine göre bir tür geçiş ücreti istiyorlarmış.
Dialogue: 0,0:11:36.96,0:11:40.86,ssrly,,0,0,0,,Onlara denk gelirsek, bir rehber bizim için pazarlık yaparsa,
Dialogue: 0,0:11:40.86,0:11:43.44,ssrly,,0,0,0,,Yükümüzün bir kısmını alıp gitmemize izin verirlermiş.
Dialogue: 0,0:11:43.44,0:11:48.06,ssrly,,0,0,0,,Yani, rehber tutarsak bize atları ödünç verecekler.
Dialogue: 0,0:11:48.06,0:11:48.69,ssrly,,0,0,0,,Evet.
Dialogue: 0,0:11:50.14,0:11:52.69,ssrly,,0,0,0,,İkisi de eğitimli savaşçılar.
Dialogue: 0,0:11:52.69,0:11:55.94,ssrly,,0,0,0,,Muhtemelen haydutların gitmesine izin vermek istemiyorlar.
Dialogue: 0,0:11:55.94,0:11:57.72,ssrly,,0,0,0,,Ama peşlerine düşecek zamanımız yok.
Dialogue: 0,0:12:01.50,0:12:04.40,ssrly,,0,0,0,,En iyi ihtimalde onlarla karşılaşmayız.
Dialogue: 0,0:12:13.12,0:12:15.80,ssrly,,0,0,0,,Oh, bu inanılmaz.
Dialogue: 0,0:12:16.42,0:12:20.72,ssrly,,0,0,0,,Lütfen bana geçmişinizde yaşadıklarınızla\N ilgili daha fazla hikaye anlatın.
Dialogue: 0,0:12:20.72,0:12:22.06,ssrly,,0,0,0,,Ah, elbette.
Dialogue: 0,0:12:22.64,0:12:25.00,ssrly,,0,0,0,,Ama önce biraz dinlenelim.
Dialogue: 0,0:12:25.00,0:12:27.20,ssrly,,0,0,0,,Bunca süre sohbet etmekten yorulmadın mı?
Dialogue: 0,0:12:27.44,0:12:29.40,ssrly,,0,0,0,,Ben iyiyim.
Dialogue: 0,0:12:29.40,0:12:32.73,ssrly,,0,0,0,,Sizinle bu kadar çok zaman geçirme \Nfırsatım pek olmuyor, Leydi Ah-Duo.
Dialogue: 0,0:12:32.73,0:12:35.32,ssrly,,0,0,0,,Daha çok konuşmak istiyorum.
Dialogue: 0,0:12:35.32,0:12:36.96,ssrly,,0,0,0,,Daha yolumuz uzun,
Dialogue: 0,0:12:36.96,0:12:38.86,ssrly,,0,0,0,,bolca zamanımız var.
Dialogue: 0,0:12:39.22,0:12:40.08,ssrly,,0,0,0,,Ama...
Dialogue: 0,0:12:40.08,0:12:43.38,ssrly,,0,0,0,,Ayrıca yolculuk sırasında farkında olmadan yorgunluğun birikir.
Dialogue: 0,0:12:44.34,0:12:46.76,ssrly,,0,0,0,,İmkanın olunca dinlenmek de önemlidir.
Dialogue: 0,0:12:46.76,0:12:48.10,ssrly,,0,0,0,,Tamam...
Dialogue: 0,0:12:49.10,0:12:53.12,ssrly,,0,0,0,,O zaman, Leydi Ah-Duo, eskisi gibi uzansam olur mu?
Dialogue: 0,0:13:07.20,0:13:09.38,ssrly,,0,0,0,,Eskisi gibi ha...
Dialogue: 0,0:13:09.38,0:13:11.88,ssrly,,0,0,0,,Üzerinden ne kadar zakit geçti acaba?
Dialogue: 0,0:13:19.74,0:13:23.08,ssrly,,0,0,0,,Hadi ama, bu kadar çabuk nefes nefese kalamazsın!
Dialogue: 0,0:13:25.86,0:13:27.44,ssrly,,0,0,0,,Kapa çeneni, bunu biliyorum.
Dialogue: 0,0:13:27.68,0:13:29.56,ssrly,,0,0,0,,Biliyorsan geri dön.
Dialogue: 0,0:13:30.02,0:13:31.54,ssrly,,0,0,0,,Yardımcıların ağlıyor.
Dialogue: 0,0:13:32.12,0:13:34.92,ssrly,,0,0,0,,Bu önemli iş, yapmak zorundasın.
Dialogue: 0,0:13:36.80,0:13:39.52,ssrly,,0,0,0,,Aramızda sadece bir yıl var, \Nbana çocukmuşum gibi davranmayı kes.
Dialogue: 0,0:13:40.99,0:13:42.22,ssrly,,0,0,0,,Belki de haklısın.
Dialogue: 0,0:13:44.04,0:13:45.12,ssrly,,0,0,0,,Artıkların mı?
Dialogue: 0,0:13:46.12,0:13:48.34,ssrly,,0,0,0,,Yemek zorunda değilsin.
Dialogue: 0,0:13:59.26,0:14:02.38,ssrly,,0,0,0,,Keşke kiminle birlikte olacağıma ben karar verebilsem.
Dialogue: 0,0:14:02.94,0:14:04.20,ssrly,,0,0,0,,Mantıksız konuşma.
Dialogue: 0,0:14:04.20,0:14:07.90,ssrly,,0,0,0,,Her bakımdan her şeyin en iyi ve en kalitelisine sahip olmalısınız.
Dialogue: 0,0:14:07.90,0:14:10.68,ssrly,,0,0,0,,Gördüğün her şeyi afiyetle yemeye başlayamazsın.
Dialogue: 0,0:14:11.32,0:14:14.64,ssrly,,0,0,0,,Aksi halde bu bir çok kişi için kötü olurdu.
Dialogue: 0,0:14:15.38,0:14:17.04,ssrly,,0,0,0,,O, annemden daha yaşlıydı.
Dialogue: 0,0:14:18.04,0:14:20.84,ssrly,,0,0,0,,Hadi ama, buna nasıl cevap vereceğimi bilmiyorum.
Dialogue: 0,0:14:21.76,0:14:23.32,ssrly,,0,0,0,,Biliyorum ama...
Dialogue: 0,0:14:24.36,0:14:25.44,ssrly,,0,0,0,,Büyü artık.
Dialogue: 0,0:14:25.68,0:14:27.22,ssrly,,0,0,0,,Ne kadar da kendini beğenmiş.
Dialogue: 0,0:14:27.22,0:14:30.34,ssrly,,0,0,0,,Her şeyi sakin bir şekilde kabullenebileceğini mi sanıyorsun?
Dialogue: 0,0:14:30.90,0:14:31.86,ssrly,,0,0,0,,O halde...
Dialogue: 0,0:14:37.70,0:14:38.62,ssrly,,0,0,0,,Kararımı verdim.
Dialogue: 0,0:14:38.88,0:14:39.64,ssrly,,0,0,0,,Ne hakkında?
Dialogue: 0,0:14:44.34,0:14:46.38,ssrly,,0,0,0,,Bu geceyi kiminle geçireceğime...
Dialogue: 0,0:14:55.84,0:15:00.44,ssrly,,0,0,0,,Onun, bir prens olarak, beni cariyesi yapmasını hiç beklemiyordum.
Dialogue: 0,0:15:15.38,0:15:20.00,ssrly,,0,0,0,,Onu ara sıra görebiliyordum ve büyümesini izleyebiliyordum.
Dialogue: 0,0:15:20.64,0:15:21.54,ssrly,,0,0,0,,Ayrıca...
Dialogue: 0,0:15:26.78,0:15:31.16,ssrly,,0,0,0,,Genç Lish'yu eski imparatorun elinden kurtarmayı başardım.
Dialogue: 0,0:15:36.46,0:15:37.12,ssrly,,0,0,0,,Ne oldu?
Dialogue: 0,0:15:37.12,0:15:38.50,ssrly,,0,0,0,,Ah-Duo?
Dialogue: 0,0:15:38.50,0:15:39.84,ssrly,,0,0,0,,Haydutlar... Haydutlar geldi!
Dialogue: 0,0:15:39.84,0:15:41.36,ssrly,,0,0,0,,Ne?!
Dialogue: 0,0:15:45.44,0:15:47.28,ssrly,,0,0,0,,Sanırım yakında dağlara yaklaşacağız.
Dialogue: 0,0:15:49.18,0:15:52.16,ssrly,,0,0,0,,Haydutlar ortaya çıkarsa burada olacaktır.
Dialogue: 0,0:15:52.93,0:15:57.42,ssrly,,0,0,0,,Dağlar arasındaki boşluk. Evet, burası pusu için mükemmel bir yer.
Dialogue: 0,0:15:57.80,0:16:01.54,ssrly,,0,0,0,,Aptal değiller, öldürmekten kaçınabilirlerse bu onlar içinde iyi olur.
Dialogue: 0,0:16:01.82,0:16:04.94,ssrly,,0,0,0,,Erzaklarımızın yarısını geride bırakmak yeterli olmalı.
Dialogue: 0,0:16:06.36,0:16:09.86,ssrly,,0,0,0,,Ayrıca, onlar sadece üç seferden birinde ortaya çıkıyor.
Dialogue: 0,0:16:10.36,0:16:14.74,ssrly,,0,0,0,,Anlıyorum. Bu oranda, tüccarlar bu olayı daha kolay kabullenirlerdi.
Dialogue: 0,0:16:15.16,0:16:19.56,ssrly,,0,0,0,,Her zaman saldırıya uğramıyorlar ve yol değiştirmek daha pahalı olacaktır.
Dialogue: 0,0:16:19.56,0:16:22.76,ssrly,,0,0,0,,Bunu pahalı bir geçiş ücreti olarak düşünseniz yeter.
Dialogue: 0,0:16:22.76,0:16:25.76,ssrly,,0,0,0,,Ayrıca kendilerini saygıdeğer hırsızlar olarak görüyorlar.
Dialogue: 0,0:16:25.76,0:16:26.86,ssrly,,0,0,0,,Saygıdeğer?!
Dialogue: 0,0:16:27.62,0:16:32.42,ssrly,,0,0,0,,Haydutlar gerçekten saldırırsa bu adam kendisini gerçekten tutabilir mi?
Dialogue: 0,0:16:36.58,0:16:40.32,ssrly,,0,0,0,,Jinshi-sama, kurak topraklar için yetiştirilmiş atları sürmeyi eğlenceli buldu,
Dialogue: 0,0:16:40.32,0:16:42.78,ssrly,,0,0,0,,at sırtında gitmeye karar verdi.
Dialogue: 0,0:16:43.24,0:16:45.68,ssrly,,0,0,0,,Basen de aynısını yapmak zorunda kaldı.
Dialogue: 0,0:16:46.64,0:16:50.08,ssrly,,0,0,0,,Sonuç olarak, bu devasa araba tamamen bana kaldı.
Dialogue: 0,0:16:50.08,0:16:53.50,ssrly,,0,0,0,,Bu kadar uzun süre hareketsiz oturmak popomu ağrıtıyor.
Dialogue: 0,0:16:53.50,0:16:55.76,ssrly,,0,0,0,,Ve bu yüzden yatıyorum.
Dialogue: 0,0:16:56.60,0:17:01.00,ssrly,,0,0,0,,Ortaya çıkıp çıkmayacağı belli olmayan haydutlar hakkında endişelenmek anlamsız.
Dialogue: 0,0:17:01.00,0:17:04.16,ssrly,,0,0,0,,Yapabiliyorken kestirmeliyim.
Dialogue: 0,0:17:14.54,0:17:16.06,ssrly,,0,0,0,,Ne oldu?
Dialogue: 0,0:17:16.30,0:17:18.66,ssrly,,0,0,0,,Sanırım haydutlar ortaya çıkmış ve
Dialogue: 0,0:17:18.66,0:17:21.98,ssrly,,0,0,0,,bizden ileride olan bir araç saldırıya uğramış.
Dialogue: 0,0:17:22.38,0:17:24.32,ssrly,,0,0,0,,Biraz beklemeliyiz.
Dialogue: 0,0:17:24.32,0:17:28.72,ssrly,,0,0,0,,Yani burada beklersek beladan uzak durabiliriz.
Dialogue: 0,0:17:32.34,0:17:33.03,ssrly,,0,0,0,,Neler oluyor...
Dialogue: 0,0:17:35.22,0:17:35.88,ssrly,,0,0,0,,Gidelim!
Dialogue: 0,0:17:35.88,0:17:36.66,ssrly,,0,0,0,,Evet!
Dialogue: 0,0:17:41.74,0:17:42.62,ssrly,,0,0,0,,Uyuyordun.
Dialogue: 0,0:17:42.62,0:17:44.36,ssrly,,0,0,0,,Neden bahsediyorsunuz?
Dialogue: 0,0:17:44.36,0:17:46.52,ssrly,,0,0,0,,Yüzünde iz olmuş.
Dialogue: 0,0:17:49.05,0:17:51.30,ssrly,,0,0,0,,Her neyse, neler oluyor?
Dialogue: 0,0:17:53.68,0:17:55.00,ssrly,,0,0,0,,Bu sembol..
Dialogue: 0,0:17:55.50,0:17:56.00,ssrly,,0,0,0,,Evet.
Dialogue: 0,0:17:56.58,0:17:59.45,ssrly,,0,0,0,,Saldırıya uğrayan araç Ah-Duo'nun aracı.
Dialogue: 0,0:17:59.90,0:18:01.98,ssrly,,0,0,0,,Neden Leydi Ah-Duo burada?
Dialogue: 0,0:18:01.98,0:18:07.40,ssrly,,0,0,0,,Ancak Leydi Ah-Duo'nun barışçıl bir şekilde pazarlık \Nyapabileceği bol miktarda değerli malı olsa gerek.
Dialogue: 0,0:18:07.40,0:18:09.32,ssrly,,0,0,0,,Yanında Cariye Lishu var.
Dialogue: 0,0:18:10.66,0:18:13.07,ssrly,,0,0,0,,Her şey aniden tehlikeli hale geldi!
Dialogue: 0,0:18:13.07,0:18:15.68,ssrly,,0,0,0,,Sürekli başına tuhaf talihsizlikler gelen bir cariye.
Dialogue: 0,0:18:15.68,0:18:19.14,ssrly,,0,0,0,,Bu kadar az kişiyle idare edebilecekler mi?
Dialogue: 0,0:18:19.14,0:18:21.96,ssrly,,0,0,0,,Aslında, Basen muhtemelen kendi başına idare edebilir.
Dialogue: 0,0:18:41.10,0:18:45.96,ssrly,,0,0,0,,Bu duruma düşmek için ne tür bir kavgaya tutuştular?
Dialogue: 0,0:18:47.80,0:18:49.11,ssrly,,0,0,0,,O da ne?
Dialogue: 0,0:18:49.11,0:18:50.60,ssrly,,0,0,0,,Ne oluyor ya-?
Dialogue: 0,0:18:51.76,0:18:54.50,ssrly,,0,0,0,,Onların parayla geçilebilir olduğunu söylememiş miydin!?
Dialogue: 0,0:18:55.60,0:18:58.04,ssrly,,0,0,0,,Onlara değerli mallarımızı vermeye hazırdım,
Dialogue: 0,0:18:58.04,0:19:00.28,ssrly,,0,0,0,,ama kadınları satmakla tehtit ettiler.
Dialogue: 0,0:19:00.28,0:19:03.76,ssrly,,0,0,0,,Bunun bizim gözetimimizde gerçekleşmesine izin veremezdik.
Dialogue: 0,0:19:04.36,0:19:06.34,ssrly,,0,0,0,,Bu-u şey... bilmiyorum...
Dialogue: 0,0:19:06.34,0:19:09.44,ssrly,,0,0,0,,Neler olduğu hakkında bir fikrim yok.
Dialogue: 0,0:19:18.04,0:19:19.08,ssrly,,0,0,0,,İzninizle.
Dialogue: 0,0:19:20.28,0:19:22.08,ssrly,,0,0,0,,Tamamı paramparça olmuş.
Dialogue: 0,0:19:22.38,0:19:26.84,ssrly,,0,0,0,,Eğer kesik düzgün olsaydı babam tekrar yerine takabilirdi,
Dialogue: 0,0:19:27.38,0:19:29.46,ssrly,,0,0,0,,Ama o yetenek bende yok.
Dialogue: 0,0:19:29.68,0:19:33.15,ssrly,,0,0,0,,Zorla birleştirsem bile yine çürüyüp kopardı.
Dialogue: 0,0:19:33.15,0:19:34.82,ssrly,,0,0,0,,Elimden geleni yapmalıyım...
Dialogue: 0,0:19:40.50,0:19:41.78,ssrly,,0,0,0,,Bunu kullan.
Dialogue: 0,0:19:42.66,0:19:45.62,ssrly,,0,0,0,,Orada yaralanan başkaları da vardı ve çok zaman aldı.
Dialogue: 0,0:19:46.18,0:19:47.98,ssrly,,0,0,0,,Sen de buradasın!
Dialogue: 0,0:19:48.40,0:19:49.17,ssrly,,0,0,0,,Evet.
Dialogue: 0,0:19:49.40,0:19:52.92,ssrly,,0,0,0,,Villadan ayrılmama izin \Nvermelerine ben de şaşırmıştım.
Dialogue: 0,0:19:53.17,0:19:55.08,ssrly,,0,0,0,,Onu bile getirmişler.
Dialogue: 0,0:19:55.08,0:19:58.08,ssrly,,0,0,0,,Batı Başkent'te ne haltlar dönüyor?
Dialogue: 0,0:20:00.22,0:20:01.72,ssrly,,0,0,0,,Dikiş yapmakta iyi misin?
Dialogue: 0,0:20:01.72,0:20:03.52,ssrly,,0,0,0,,Biraz biliyorum.
Dialogue: 0,0:20:03.52,0:20:06.20,ssrly,,0,0,0,,Anestezimiz olmaması çok yazık.
Dialogue: 0,0:20:09.19,0:20:10.78,ssrly,,0,0,0,,Dayanmaya çalış.
Dialogue: 0,0:20:24.56,0:20:27.76,ssrly,,0,0,0,,Görünüşe göre haydutlarla ilgili pek çok şey ters gitmiş.
Dialogue: 0,0:20:28.62,0:20:33.70,ssrly,,0,0,0,,Hikayenin özü, zengin bir çocuğun uzak \Nbir bürokrat olarak görevlendirilmesiydi.
Dialogue: 0,0:20:33.70,0:20:36.70,ssrly,,0,0,0,,Ama bundan daha önemli olduklarını fark ettiler.
Dialogue: 0,0:20:36.70,0:20:39.64,ssrly,,0,0,0,,Burada kimin olduğu düşünülürse bu kaçınılmaz...
Dialogue: 0,0:20:43.46,0:20:44.82,ssrly,,0,0,0,,Müsadenizle.
Dialogue: 0,0:20:45.06,0:20:46.88,ssrly,,0,0,0,,Evet, buraya.
Dialogue: 0,0:20:48.92,0:20:51.42,ssrly,,0,0,0,,Direkt sizinle konuşmam istendi.
Dialogue: 0,0:20:53.70,0:20:56.54,ssrly,,0,0,0,,Neden Leydi Lishu da burada?
Dialogue: 0,0:20:57.24,0:21:00.14,ssrly,,0,0,0,,Cariyeler arka saraydan ayrılamamalı.
Dialogue: 0,0:21:00.70,0:21:01.52,ssrly,,0,0,0,,Ayrıca
Dialogue: 0,0:21:01.86,0:21:02.86,ssrly,,0,0,0,,Suirei,
Dialogue: 0,0:21:03.40,0:21:08.54,ssrly,,0,0,0,,o oldukça yetenekli, yani uzun bir yolculukta onu yanlarında doktor olarak istemeleri anlaşılabilir.
Dialogue: 0,0:21:08.96,0:21:12.12,ssrly,,0,0,0,,Yine de, ortada bazı sorunlar var.
Dialogue: 0,0:21:13.04,0:21:17.26,ssrly,,0,0,0,,Cariyenin neden burada olduğunu bilmek istiyorsun, değil mi?
Dialogue: 0,0:21:17.26,0:21:18.52,ssrly,,0,0,0,,Evet.
Dialogue: 0,0:21:18.52,0:21:22.12,ssrly,,0,0,0,,{\i1}Efendi Basen{\i0}'in neden batıya gittiği konusunda bilgilendirildin mi?
Dialogue: 0,0:21:23.24,0:21:27.76,ssrly,,0,0,0,,Jinshi-sama şu an kılık değiştiriyor; bu yüzden rolünü sürdürmek için "Basen"den bahsediyor.
Dialogue: 0,0:21:27.76,0:21:29.94,ssrly,,0,0,0,,Leydi Ah-Duo her zamanki gibi sağduyulu.
Dialogue: 0,0:21:29.94,0:21:32.10,ssrly,,0,0,0,,Batıda bir toplantı yapılacağı söylendi.
Dialogue: 0,0:21:32.64,0:21:36.08,ssrly,,0,0,0,,"Efendi Basen"in yanı sıra birçok önemli kişi de orada olacak.
Dialogue: 0,0:21:36.56,0:21:38.94,ssrly,,0,0,0,,Biz de o toplantıya katılacağız.
Dialogue: 0,0:21:39.18,0:21:43.32,ssrly,,0,0,0,,Cariyeler burada olduğu için kalabalık bir grup olarak seyahat etmekten kaçındık.
Dialogue: 0,0:21:43.32,0:21:47.84,ssrly,,0,0,0,,Ya da daha doğrusu, \Nbize bir yükmüşüz gibi davranıldı.
Dialogue: 0,0:21:48.84,0:21:51.04,ssrly,,0,0,0,,Bu alt metinlerle dolu bir cümle.
Dialogue: 0,0:21:51.04,0:21:56.18,ssrly,,0,0,0,,Ayrıca Leydi Lishu'nun Batı ile yapılacak bir görüşmeye ne gibi bir katkısı olabilir, anlamıyorum.
Dialogue: 0,0:21:56.18,0:21:56.18,ssrly,,0,0,0,,
Dialogue: 0,0:21:56.18,0:21:58.52,ssrly,,0,0,0,,Batı'dan gelen Leydi Gyokuyou,
Dialogue: 0,0:21:58.52,0:22:02.02,ssrly,,0,0,0,,ya da imparatorun kanından olan Leydi Lihua daha mantıklı olurdu.
Dialogue: 0,0:22:04.60,0:22:08.20,ssrly,,0,0,0,,Bu toplantının bir diğer amacı ise eş seçmek.
Dialogue: 0,0:22:09.02,0:22:10.44,ssrly,,0,0,0,,Eş seçmek mi?
Dialogue: 0,0:22:10.94,0:22:14.06,ssrly,,0,0,0,,Evet. İmparatorun erkek kardeşi için bir eş.
Dialogue: 0,0:23:53.62,0:23:57.12,ssrly,,0,0,0,,{\pos(928,102)}Bir sonraki bölüm: "Sorunlar Birikiyor"
